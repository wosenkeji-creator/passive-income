{
  "title": "Welcome to the Jungle Job Scraper input",
  "type": "object",
  "schemaVersion": 1,
  "properties": {
    "sitemapUrl": {
      "title": "Sitemap URL",
      "type": "string",
      "description": "Public WTTJ sitemap index. Override only for a compatible test fixture.",
      "default": "https://www.welcometothejungle.com/sitemaps/index.xml.gz"
    },
    "maxResults": {
      "title": "Maximum results",
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "default": 100
    },
    "maxPages": {
      "title": "Maximum detail pages",
      "type": "integer",
      "minimum": 1,
      "maximum": 10000,
      "default": 500
    },
    "concurrency": {
      "title": "Concurrency",
      "type": "integer",
      "minimum": 1,
      "maximum": 20,
      "default": 5
    },
    "requestTimeoutMs": {
      "title": "Request timeout (ms)",
      "type": "integer",
      "minimum": 1000,
      "maximum": 120000,
      "default": 30000
    },
    "country": { "title": "Country", "type": "string" },
    "city": { "title": "City", "type": "string" },
    "contractType": { "title": "Contract type", "type": "string" },
    "company": { "title": "Company", "type": "string" },
    "updatedSince": {
      "title": "Updated since",
      "type": "string",
      "description": "ISO-8601 date; sitemap entries without lastmod are retained."
    },
    "includeDescription": {
      "title": "Include description",
      "type": "boolean",
      "default": true
    }
  }
}
